[sub_resource type="GDScript" id="GDScript_wbgqb"]
script/source = "@tool
extends Node3D
@export var base_y: float = 33.3
@export var speed: float = 2.0
@export var y_range: float = 5.

@onready var side: Node3D = $Null_1/w_1
var time_passed: float = 0.

func _process(delta: float) -> void:
	time_passed += delta 
	var sin_r = sin(time_passed * speed) * y_range + base_y
	side.rotation.y = deg_to_rad(sin_r)
	
"

