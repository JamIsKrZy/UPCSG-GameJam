[resource]
script = ExtResource("1_hgggd")
account = "Tuberculosis Boy"
description = "Hosea Matthews was the quiet backbone of the Van der Linde gang, known for his wisdom, patience, and careful planning. While others relied on force or bravado, Hosea believed in reason and doing things with as little bloodshed as possible. His death marked the point when everything truly began to fall apart, showing that the gang did not just lose a member, but its moral compass as well."
