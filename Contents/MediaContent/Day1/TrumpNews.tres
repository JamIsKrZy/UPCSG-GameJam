[resource]
script = ExtResource("1_nps1d")
account = "Brian Goeff"
description = "Tensions flared this month after U.S. President Donald Trump renewed his push for American influence over Greenland, a semiautonomous territory of Denmark. Trump’s remarks sparked international concern as European leaders and Greenlandic officials stressed that Greenland’s sovereignty must be respected, even as talks began between the U.S., Denmark, and Greenland to address Arctic security and cooperation."
images = Array[Texture2D]([ExtResource("1_ndtpr")])
