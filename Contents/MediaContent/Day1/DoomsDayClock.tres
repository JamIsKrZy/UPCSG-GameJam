script = ExtResource("1_b6a36")
account = "Brian Goeff"
description = "On January 27, 2026, the Doomsday Clock was moved to just 85 seconds before midnight, marking the closest it has ever been to symbolizing global catastrophe. The Bulletin of the Atomic Scientists’ Science and Security Board urged immediate action, calling for reductions in nuclear arsenals, the establishment of international rules governing the use of artificial intelligence, and stronger multilateral efforts to address global biological threats."
