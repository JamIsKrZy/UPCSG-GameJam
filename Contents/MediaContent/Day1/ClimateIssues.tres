[resource]
script = ExtResource("1_ynt7h")
account = "Erica Wiever"
description = "Scientists and courts around the world are raising the alarm as the climate crisis deepens. In the Caribbean, a Dutch court ruled that the Netherlands must create a stronger climate plan to protect the island of Bonaire from rising seas and extreme weather, a decision hailed as a breakthrough for climate justice. Meanwhile, severe heatwaves in Australia are smashing temperature records and scorching cities, and new research shows that human-driven climate change made recent deadly floods in southern Africa far worse. These events underscore that global warming continues to intensify, with far-reaching impacts on people and ecosystems everywhere."
likes = 8765
